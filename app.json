{
  "expo": {
    "name": "poplicuentos",
    "slug": "popli-54",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "poplicuentos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E1B4B",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.loredufa.poplicuentos"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#1E1B4B",
          "dark": {
            "backgroundColor": "#1E1B4B"
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "API_BASE_URL_PROD": "https://poplicuentos-api.vercel.app",
      "API_BASE_URL_DEV": "http://localhost:3000",
      "API_BASE_URL": "https://poplicuentos-api.vercel.app",
      "LOGIN_PATH": "/api/login",
      "REGISTER_PATH": "/api/register",
      "FORGOT_PATH": "/api/auth/request-reset",
      "RESET_PASSWORD_PATH": "/api/auth/reset-password",
      "CHANGE_PASSWORD_PATH": "/api/auth/change-password",
      "TWOFA_SETUP_PATH": "/api/auth/2fa/setup",
      "TWOFA_ENABLE_PATH": "/api/auth/2fa/enable",
      "TWOFA_VERIFY_PATH": "/api/auth/2fa/verify-login",
      "TWOFA_STATUS_PATH": "/api/auth/2fa/status",
      "TWOFA_DISABLE_PATH": "/api/auth/2fa/disable",
      "TWOFA_BACKUP_REGEN_PATH": "/api/auth/2fa/backup-codes/regenerate",
      "ME_PATH": "/api/me",
      "PROFILE_PATH": "/api/profile",
      "LOGOUT_PATH": "/api/logout",
      "TTS_VOICES_PATH": "/api/tts/voices",
      "TTS_PREVIEW_PATH": "/api/tts/preview",
      "TTS_NARRATE_PATH": "/api/tts/narrate",
      "STORY_PDF_PATH": "/api/story/pdf",
      "router": {},
      "eas": {
        "projectId": "e139dd0b-c1dd-4f74-b7b3-4ac6c8738542"
      }
    },
    "updates": {
      "enabled": false
    },
    "owner": "loredufa"
  }
}
