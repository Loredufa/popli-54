{
  "expo": {
    "name": "popli-54",
    "slug": "popli-54",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_fondo_claro.png",
    "scheme": "popli54",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo_fondo_claro_adaptive.png",
        "monochromeImage": "./assets/images/logo_fondo_claro_monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.loredufa.popli54"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "API_BASE_URL": "https://poplicuentos-api.vercel.app",
      "API_BASE_URL_DEV": "http://localhost:3000",
      "LOGIN_PATH": "/api/login",
      "REGISTER_PATH": "/api/register",
      "FORGOT_PATH": "/api/auth/request-reset",
      "RESET_PASSWORD_PATH": "/api/auth/reset-password",
      "ME_PATH": "/api/me",
      "PROFILE_PATH": "/api/profile",
      "LOGOUT_PATH": "/api/logout",
      "TTS_VOICES_PATH": "/api/tts/voices",
      "TTS_PREVIEW_PATH": "/api/tts/preview",
      "TTS_NARRATE_PATH": "/api/tts/narrate",
      "STORY_PDF_PATH": "/api/story/pdf"
    },
    "updates": {
      "enabled": false
    }
  }
}
